# ═══════════════════════════════════════════════════════════════
# MOMENTO — Environment Configuration
# Copy this file to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── AI Engine (Required for live offer generation) ────────────
# Get your key at: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini (structured JSON output)
OPENAI_API_KEY=your_openai_api_key_here

# ── Weather Context (Required for City Ambient Clock) ─────────
# Free tier at: https://openweathermap.org/api
# Falls back to mock weather data if not set
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ── Security (Required) ──────────────────────────────────────
# Used for HMAC-SHA256 QR token signing
# IMPORTANT: Use a strong random string (≥32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=your_hmac_secret_here

# ── Server ───────────────────────────────────────────────────
PORT=3001
